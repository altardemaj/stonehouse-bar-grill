{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "stonehouse-grill.com" }
      ],
      "destination": "https://www.stonehouse-grill.com/:path*",
      "permanent": true
    }
  ]
}
